{
  "name": "knowledge-dock",
  "version": "1.0.0",
  "description": "ActionDock Knowledge Dock - Unified Cloud Knowledge Server & Agent Orchestration Workspace",
  "type": "module",
  "workspaces": [
    "server/packages/*",
    "client/packages/*"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "docker compose build",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "restart": "docker compose restart",
    "shell": "docker exec -it knowledge-server bash",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "keywords": [
    "actiondock",
    "knowledge",
    "monorepo",
    "docker",
    "server"
  ],
  "author": "ActionDock Knowledge Team",
  "license": "MIT"
}
