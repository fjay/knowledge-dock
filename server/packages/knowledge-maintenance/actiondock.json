    "maintenance.complete": {
      "entry": "actions/maintenance-complete.ts",
      "description": "Advance repository knowledge maintenance checkpoint after review, validating commit existence and updating persistent state.",
      "inputSchema": {
        "type": "object",
        "required": [
          "path",
          "commit"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Local repository workspace directory path",
            "examples": [
              "/srv/workspace/order-service"
            ]
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{7,40}$",
            "description": "Commit hash (7 to 40 hex characters) to record as the latest inspected checkpoint",
            "examples": [
              "b2c3d4e",
              "b2c3d4e5f607182930415263748596a7b8c9d0e1"
            ]
          },
          "actionTaken": {
            "type": "string",
            "enum": [
              "docs_updated",
              "no_change_needed",
              "skipped"
            ],
            "description": "Action taken during maintainer review. Defaults to 'no_change_needed'.",
            "examples": [
              "docs_updated",
              "no_change_needed",
              "skipped"
            ]
          },
          "summary": {
            "type": "string",
            "description": "Optional summary description or notes about the review",
            "examples": [
              "Updated flow doc for budget limit check",
              "Reviewed auth changes, no knowledge impact"
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "repo",
          "path",
          "previousCommit",
          "currentCommit",
          "updatedAt"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "description": "Repository identifier or name"
          },
          "path": {
            "type": "string",
            "description": "Resolved repository path"
          },
          "previousCommit": {
            "type": [
              "string",
              "null"
            ],
            "description": "Previous checkpoint commit before update, or null if first completion"
          },
          "currentCommit": {
            "type": "string",
            "description": "Updated checkpoint commit hash (resolved 40-character hex)"
          },
          "actionTaken": {
            "type": "string",
            "enum": [
              "docs_updated",
              "no_change_needed",
              "skipped"
            ],
            "description": "Action recorded for this maintenance cycle"
          },
          "summary": {
            "type": "string",
            "description": "Summary notes recorded for this maintenance cycle"
          },
          "updatedAt": {
            "type": "string",
            "description": "ISO 8601 timestamp of checkpoint recording"
          }
        }
      },
      "examples": [
        {
          "title": "Complete review with docs updated",
          "input": {
            "path": "/srv/workspace/order-service",
            "commit": "b2c3d4e5f607182930415263748596a7b8c9d0e1",
            "actionTaken": "docs_updated",
            "summary": "Updated flow doc for budget limit check"
          },
          "output": {
            "repo": "order-service",
            "path": "/srv/workspace/order-service",
            "previousCommit": "a1b2c3d4e5f607182930415263748596a7b8c9d0",
            "currentCommit": "b2c3d4e5f607182930415263748596a7b8c9d0e1",
            "actionTaken": "docs_updated",
            "summary": "Updated flow doc for budget limit check",
            "updatedAt": "2026-09-24T09:00:00.000Z"
          }
        },
        {
          "title": "Complete review with no changes needed",
          "input": {
            "path": "/srv/workspace/order-service",
            "commit": "b2c3d4e"
          },
          "output": {
            "repo": "order-service",
            "path": "/srv/workspace/order-service",
            "previousCommit": null,
            "currentCommit": "b2c3d4e5f607182930415263748596a7b8c9d0e1",
            "actionTaken": "no_change_needed",
            "summary": "",
            "updatedAt": "2026-09-24T09:00:00.000Z"
          }
        }
      ]
    },
    "maintenance.publish": {
      "entry": "actions/maintenance-publish.ts",
      "description": "Commit and push local knowledge documentation modifications to remote origin branch (e.g. docs branch for code repos or master for system_knowledge).",
      "inputSchema": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Local repository workspace directory path",
            "examples": [
              "/srv/workspace/order-service",
              "/srv/workspace/system-knowledge"
            ]
          },
          "repoType": {
            "type": "string",
            "enum": [
              "code",
              "system_knowledge",
              "inbox"
            ],
            "description": "Repository architecture type. Auto-detected if omitted.",
            "examples": [
              "code",
              "system_knowledge",
              "inbox"
            ]
          },
          "branch": {
            "type": "string",
            "description": "Target branch to push to. Defaults to 'master' for system_knowledge and 'docs' for code repositories.",
            "examples": [
              "master",
              "docs"
            ]
          },
          "message": {
            "type": "string",
            "description": "Git commit message",
            "examples": [
              "docs: update knowledge documentation",
              "docs(system): sync payment domain flow from order-service"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional list of specific files or directories to stage and commit. Defaults to all changes.",
            "examples": [
              [
                "docs/knowledge"
              ]
            ]
          },
          "push": {
            "type": "boolean",
            "description": "Whether to push committed changes to remote origin (default: true)",
            "examples": [
              true,
              false
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "status",
          "path",
          "repo",
          "branch",
          "committed",
          "pushed",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "no_changes",
              "error"
            ],
            "description": "Outcome status: 'success' (changes committed/pushed), 'no_changes' (clean working tree), or 'error' (git failure)"
          },
          "path": {
            "type": "string",
            "description": "Resolved repository path"
          },
          "repo": {
            "type": "string",
            "description": "Repository identifier or name"
          },
          "branch": {
            "type": "string",
            "description": "Branch that was committed to"
          },
          "committed": {
            "type": "boolean",
            "description": "Whether a git commit was created"
          },
          "pushed": {
            "type": "boolean",
            "description": "Whether changes were pushed to origin"
          },
          "commit": {
            "type": "string",
            "description": "Commit hash of the new commit if committed"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of staged files included in the commit"
          },
          "message": {
            "type": "string",
            "description": "Human-readable summary of the publish operation"
          }
        }
      }
    }
  },
