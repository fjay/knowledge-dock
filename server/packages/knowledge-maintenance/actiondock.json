{
  "$schema": "https://actiondock.dev/schema/v2.json",
  "schemaVersion": 2,
  "id": "maintenance",
  "name": "Knowledge Maintenance",
  "version": "0.1.0",
  "description": "Privileged maintenance plane for git-based knowledge synchronization, status scanning, and checkpoint progression",
  "config": {
    "GIT_TIMEOUT_MS": {
      "type": "integer",
      "description": "Default timeout in milliseconds for git operations (default: 30000)",
      "env": "GIT_TIMEOUT_MS"
    },
    "GIT_CLONE_TIMEOUT_MS": {
      "type": "integer",
      "description": "Default timeout in milliseconds for git clone operations (default: 300000, 5 minutes)",
      "env": "GIT_CLONE_TIMEOUT_MS"
    },
    "GIT_MAX_OUTPUT_BYTES": {
      "type": "integer",
      "description": "Maximum bytes collected from git command output (default: 4194304)",
      "env": "GIT_MAX_OUTPUT_BYTES"
    },
    "GIT_BLOBLESS_FETCH": {
      "type": "boolean",
      "description": "Whether to use --filter=blob:none by default when fetching from remote origin (default: true)",
      "env": "GIT_BLOBLESS_FETCH"
    },
    "GIT_AUTHOR_NAME": {
      "type": "string",
      "description": "Git commit author and committer name (default: Knowledge Maintainer)",
      "env": "GIT_AUTHOR_NAME"
    },
    "GIT_AUTHOR_EMAIL": {
      "type": "string",
      "description": "Git commit author and committer email (default: maintainer@actiondock.local)",
      "env": "GIT_AUTHOR_EMAIL"
    }
  },
  "actions": {
    "maintenance.sync": {
      "entry": "actions/maintenance-sync.ts",
      "description": "Synchronize code or system knowledge repositories with remote origin, performing branch fast-forward or release-to-docs merge, and safely aborting on conflict without hard resets or force pushes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Local repository workspace directory path (optional; if omitted, batch mode is executed)",
            "examples": [
              "/srv/workspace/order-service",
              "/srv/workspace/system-knowledge"
            ]
          },
          "url": {
            "type": "string",
            "description": "Remote Git repository URL used to auto-clone when the local workspace does not exist",
            "examples": [
              "https://github.com/example/repo.git",
              "git@github.com:example/repo.git"
            ]
          },
          "config": {
            "type": "string",
            "description": "Path to repository configuration JSON file (defaults to /etc/actiondock/repos.json if omitted)",
            "examples": [
              "/etc/actiondock/repos.json",
              "/srv/workspace/config/repos.json"
            ]
          },
          "repoType": {
            "type": "string",
            "enum": [
              "code",
              "system_knowledge",
              "inbox"
            ],
            "description": "Repository architecture type. 'code' uses dual branches (release & docs), 'system_knowledge' uses single branch (master). Auto-detected if omitted.",
            "examples": [
              "code",
              "system_knowledge"
            ]
          },
          "sourceBranch": {
            "type": "string",
            "description": "Source iteration branch. Defaults to 'release' for code repos and 'master' for system_knowledge repos.",
            "examples": [
              "release",
              "master"
            ]
          },
          "knowledgeBranch": {
            "type": "string",
            "description": "Knowledge documentation branch for dual-branch code repos. Defaults to 'docs'. Not used for system_knowledge repos.",
            "examples": [
              "docs"
            ]
          },
          "filterBlobNone": {
            "type": "boolean",
            "description": "Use Blobless partial fetch (--filter=blob:none) to drastically reduce network and disk transfer. Defaults to true. Automatically falls back to standard fetch if the remote server does not support partial clone filters.",
            "examples": [
              true,
              false
            ]
          },
          "cloneTimeoutMs": {
            "type": "integer",
            "description": "Custom timeout in milliseconds for git clone operations if cloning is required"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "status",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "dirty_worktree",
              "conflict",
              "error"
            ],
            "description": "Synchronization outcome status: 'success' (synced and pushed), 'dirty_worktree' (uncommitted changes detected), 'conflict' (merge conflict detected and aborted), or 'error' (fatal git/execution failure)"
          },
          "batch": {
            "type": "boolean",
            "description": "Whether synchronization was executed in batch mode across multiple repositories"
          },
          "path": {
            "type": "string",
            "description": "Resolved repository root path (for single-repo mode)"
          },
          "repoType": {
            "type": "string",
            "enum": [
              "code",
              "system_knowledge",
              "inbox"
            ],
            "description": "Repository type applied during sync"
          },
          "sourceBranch": {
            "type": "string",
            "description": "Source branch used for synchronization"
          },
          "knowledgeBranch": {
            "type": "string",
            "description": "Knowledge branch used (for code repositories)"
          },
          "currentCommit": {
            "type": "string",
            "description": "Target branch HEAD commit hash after sync"
          },
          "uncommittedFiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of dirty or uncommitted files if status is 'dirty_worktree'"
          },
          "conflictFiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of conflicting files if status is 'conflict'"
          },
          "initializedBranch": {
            "type": "boolean",
            "description": "Whether the knowledge branch was newly created and initialized on remote"
          },
          "cloned": {
            "type": "boolean",
            "description": "Whether the repository was newly cloned during synchronization"
          },
          "summary": {
            "type": "object",
            "required": [
              "total",
              "syncedCount",
              "conflictCount",
              "errorCount"
            ],
            "properties": {
              "total": {
                "type": "integer",
                "description": "Total number of repositories processed"
              },
              "syncedCount": {
                "type": "integer",
                "description": "Number of successfully synchronized repositories"
              },
              "conflictCount": {
                "type": "integer",
                "description": "Number of repositories with merge conflicts"
              },
              "errorCount": {
                "type": "integer",
                "description": "Number of repositories with errors or dirty worktrees"
              }
            },
            "description": "Batch synchronization summary statistics"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "status",
                "path",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "success",
                    "dirty_worktree",
                    "conflict",
                    "error"
                  ],
                  "description": "Outcome status of single repository sync"
                },
                "path": {
                  "type": "string",
                  "description": "Repository path"
                },
                "repoType": {
                  "type": "string",
                  "enum": [
                    "code",
                    "system_knowledge",
                    "inbox"
                  ],
                  "description": "Repository architecture type"
                },
                "sourceBranch": {
                  "type": "string",
                  "description": "Source iteration branch"
                },
                "knowledgeBranch": {
                  "type": "string",
                  "description": "Knowledge branch"
                },
                "currentCommit": {
                  "type": "string",
                  "description": "Commit hash after sync"
                },
                "uncommittedFiles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "List of uncommitted files if dirty"
                },
                "conflictFiles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "List of conflicting files if conflict"
                },
                "initializedBranch": {
                  "type": "boolean",
                  "description": "Whether branch was newly initialized"
                },
                "cloned": {
                  "type": "boolean",
                  "description": "Whether the repository was newly cloned during synchronization"
                },
                "message": {
                  "type": "string",
                  "description": "Human-readable summary of repository sync"
                }
              }
            },
            "description": "Detailed execution results for each repository in batch mode"
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "conflictFiles"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Repository path where merge conflict occurred"
                },
                "sourceBranch": {
                  "type": "string",
                  "description": "Source branch"
                },
                "knowledgeBranch": {
                  "type": "string",
                  "description": "Knowledge branch"
                },
                "conflictFiles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "List of conflicting files"
                }
              }
            },
            "description": "List of conflicting repositories and their conflicting files"
          },
          "message": {
            "type": "string",
            "description": "Human-readable summary of the sync operation"
          }
        }
      },
      "examples": [
        {
          "title": "Sync dual-branch code repository successfully",
          "input": {
            "path": "/srv/workspace/order-service",
            "repoType": "code",
            "sourceBranch": "release",
            "knowledgeBranch": "docs"
          },
          "output": {
            "status": "success",
            "path": "/srv/workspace/order-service",
            "repoType": "code",
            "sourceBranch": "release",
            "knowledgeBranch": "docs",
            "currentCommit": "d4e5f607182930415263748596a7b8c9d0e1f2a3",
            "initializedBranch": false,
            "message": "Successfully synchronized release into docs and pushed to remote origin"
          }
        },
        {
          "title": "Detect dirty worktree and refuse sync",
          "input": {
            "path": "/srv/workspace/order-service"
          },
          "output": {
            "status": "dirty_worktree",
            "path": "/srv/workspace/order-service",
            "repoType": "code",
            "uncommittedFiles": [
              "M src/service.ts"
            ],
            "message": "Working tree is dirty; synchronization aborted to prevent uncommitted changes from being lost"
          }
        },
        {
          "title": "Detect merge conflict and safely abort",
          "input": {
            "path": "/srv/workspace/order-service",
            "repoType": "code"
          },
          "output": {
            "status": "conflict",
            "path": "/srv/workspace/order-service",
            "repoType": "code",
            "sourceBranch": "release",
            "knowledgeBranch": "docs",
            "conflictFiles": [
              "docs/knowledge/flow.md"
            ],
            "message": "Merge conflict detected while merging origin/release into docs; merge was safely aborted"
          }
        },
        {
          "title": "Batch synchronize multiple repositories with summary and conflict reporting",
          "input": {
            "config": "/etc/actiondock/repos.json"
          },
          "output": {
            "status": "success",
            "batch": true,
            "summary": {
              "total": 2,
              "syncedCount": 2,
              "conflictCount": 0,
              "errorCount": 0
            },
            "results": [
              {
                "status": "success",
                "path": "/srv/workspace/order-service",
                "repoType": "code",
                "sourceBranch": "release",
                "knowledgeBranch": "docs",
                "currentCommit": "d4e5f607182930415263748596a7b8c9d0e1f2a3",
                "initializedBranch": false,
                "message": "Successfully synchronized 'release' into 'docs' and pushed to remote origin"
              },
              {
                "status": "success",
                "path": "/srv/workspace/system-knowledge",
                "repoType": "system_knowledge",
                "sourceBranch": "master",
                "currentCommit": "a1b2c3d4e5f607182930415263748596a7b8c9d0",
                "message": "Successfully synchronized system knowledge branch 'master' via fast-forward merge"
              }
            ],
            "conflicts": [],
            "message": "Batch synchronization completed: 2 of 2 repositories synchronized successfully"
          }
        }
      ]
    },
    "maintenance.list": {
      "entry": "actions/maintenance-list.ts",
      "description": "Scan repository target branch against the last knowledge-checked commit checkpoint, returning pending code change diffs and commit summaries for maintainer agent inspection.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Local repository workspace directory path (optional; if omitted, batch mode is executed)",
            "examples": [
              "/srv/workspace/order-service"
            ]
          },
          "config": {
            "type": "string",
            "description": "Path to repository configuration JSON file (defaults to /etc/actiondock/repos.json if omitted). In batch mode, repositories configured with a url but missing locally are cloned automatically before scanning.",
            "examples": [
              "/etc/actiondock/repos.json",
              "/srv/workspace/config/repos.json"
            ]
          },
          "branch": {
            "type": "string",
            "description": "Target branch to inspect for changes. Defaults to 'release' for code repositories or 'master' for system knowledge repositories.",
            "examples": [
              "release",
              "master"
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "hasChanges": {
            "type": "boolean",
            "description": "Whether there are new uninspected commits since the last checkpoint"
          },
          "batch": {
            "type": "boolean",
            "description": "Whether change scan was executed in batch mode across multiple repositories"
          },
          "path": {
            "type": "string",
            "description": "Resolved repository root path"
          },
          "repo": {
            "type": "string",
            "description": "Repository identifier or name"
          },
          "repoType": {
            "type": "string",
            "enum": [
              "code",
              "system_knowledge",
              "inbox"
            ],
            "description": "Repository architecture type (code or system_knowledge)"
          },
          "checkpointUpdatedAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "Timestamp when repository checkpoint was last updated in state"
          },
          "actionTaken": {
            "type": [
              "string",
              "null"
            ],
            "description": "Action taken at last checkpoint completion"
          },
          "branch": {
            "type": "string",
            "description": "Inspected branch name"
          },
          "from": {
            "type": [
              "string",
              "null"
            ],
            "description": "Checkpoint commit hash from ctx.state (null if initial run with no prior checkpoint)"
          },
          "to": {
            "type": "string",
            "description": "Current HEAD commit hash of the target branch"
          },
          "commitCount": {
            "type": "integer",
            "description": "Number of commits between from and to (or total commits up to HEAD for initial inventory)"
          },
          "initialInventoryRequired": {
            "type": "boolean",
            "description": "True if no checkpoint exists and full initial inventory is required (Strategy B)"
          },
          "commits": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "hash",
                "shortHash",
                "message"
              ],
              "properties": {
                "hash": {
                  "type": "string",
                  "description": "Full commit hash"
                },
                "shortHash": {
                  "type": "string",
                  "description": "Short commit hash"
                },
                "message": {
                  "type": "string",
                  "description": "Commit subject message"
                },
                "author": {
                  "type": "string",
                  "description": "Author name and email"
                },
                "date": {
                  "type": "string",
                  "description": "Commit date in ISO 8601 format"
                }
              }
            },
            "description": "List of commits between from and to"
          },
          "changedFilesSummary": {
            "type": "object",
            "properties": {
              "summaryText": {
                "type": "string",
                "description": "Raw diff stat summary line (e.g. '5 files changed, 42 insertions(+), 12 deletions(-)')"
              },
              "filesChanged": {
                "type": "integer",
                "description": "Total count of modified files"
              },
              "insertions": {
                "type": "integer",
                "description": "Total inserted lines"
              },
              "deletions": {
                "type": "integer",
                "description": "Total deleted lines"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "file",
                    "changes"
                  ],
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "changes": {
                      "type": "string"
                    }
                  }
                },
                "description": "File-by-file diff stat entries"
              }
            },
            "description": "Summary of file modifications between from and to"
          },
          "summary": {
            "type": "object",
            "required": [
              "total",
              "changedCount",
              "initialCount",
              "upToDateCount",
              "errorCount"
            ],
            "properties": {
              "total": {
                "type": "integer",
                "description": "Total number of repositories scanned"
              },
              "changedCount": {
                "type": "integer",
                "description": "Number of repositories with new pending commits"
              },
              "initialCount": {
                "type": "integer",
                "description": "Number of repositories requiring initial full inventory"
              },
              "upToDateCount": {
                "type": "integer",
                "description": "Number of repositories already up to date with checkpoint"
              },
              "errorCount": {
                "type": "integer",
                "description": "Number of repositories with errors or invalid state"
              }
            },
            "description": "Batch scan summary statistics"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "status",
                "path",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "changed",
                    "initial",
                    "upToDate",
                    "error"
                  ],
                  "description": "Maintenance scan status of repository"
                },
                "path": {
                  "type": "string",
                  "description": "Repository workspace path"
                },
                "repo": {
                  "type": "string",
                  "description": "Repository identifier or name"
                },
                "repoType": {
                  "type": "string",
                  "enum": [
                    "code",
                    "system_knowledge",
                    "inbox"
                  ],
                  "description": "Repository architecture type (code or system_knowledge)"
                },
                "checkpointUpdatedAt": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Timestamp when repository checkpoint was last updated in state"
                },
                "actionTaken": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Action taken at last checkpoint completion"
                },
                "branch": {
                  "type": "string",
                  "description": "Inspected branch name"
                },
                "hasChanges": {
                  "type": "boolean",
                  "description": "Whether this repository has pending changes or requires initial inventory"
                },
                "from": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Checkpoint commit hash from ctx.state (null if initial run with no prior checkpoint)"
                },
                "to": {
                  "type": "string",
                  "description": "Current HEAD commit hash of the target branch"
                },
                "commitCount": {
                  "type": "integer",
                  "description": "Number of commits between from and to (or total commits up to HEAD for initial inventory)"
                },
                "initialInventoryRequired": {
                  "type": "boolean",
                  "description": "True if no checkpoint exists and full initial inventory is required (Strategy B)"
                },
                "commits": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "hash",
                      "shortHash",
                      "message"
                    ],
                    "properties": {
                      "hash": {
                        "type": "string",
                        "description": "Full commit hash"
                      },
                      "shortHash": {
                        "type": "string",
                        "description": "Short commit hash"
                      },
                      "message": {
                        "type": "string",
                        "description": "Commit subject message"
                      },
                      "author": {
                        "type": "string",
                        "description": "Author name and email"
                      },
                      "date": {
                        "type": "string",
                        "description": "Commit date in ISO 8601 format"
                      }
                    }
                  },
                  "description": "List of commits between from and to"
                },
                "changedFilesSummary": {
                  "type": "object",
                  "properties": {
                    "summaryText": {
                      "type": "string",
                      "description": "Raw diff stat summary line (e.g. '5 files changed, 42 insertions(+), 12 deletions(-)')"
                    },
                    "filesChanged": {
                      "type": "integer",
                      "description": "Total count of modified files"
                    },
                    "insertions": {
                      "type": "integer",
                      "description": "Total inserted lines"
                    },
                    "deletions": {
                      "type": "integer",
                      "description": "Total deleted lines"
                    },
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "file",
                          "changes"
                        ],
                        "properties": {
                          "file": {
                            "type": "string"
                          },
                          "changes": {
                            "type": "string"
                          }
                        }
                      },
                      "description": "File-by-file diff stat entries"
                    }
                  },
                  "description": "Summary of file modifications between from and to"
                },
                "message": {
                  "type": "string",
                  "description": "Human-readable status summary for this repository"
                }
              }
            },
            "description": "Detailed execution results for each repository in batch mode"
          },
          "message": {
            "type": "string",
            "description": "Human-readable status summary"
          }
        }
      },
      "examples": [
        {
          "title": "Initial run with no prior checkpoint",
          "input": {
            "path": "/srv/workspace/order-service",
            "branch": "release"
          },
          "output": {
            "hasChanges": true,
            "path": "/srv/workspace/order-service",
            "repo": "order-service",
            "branch": "release",
            "from": null,
            "to": "a1b2c3d4e5f607182930415263748596a7b8c9d0",
            "commitCount": 142,
            "initialInventoryRequired": true,
            "commits": [],
            "message": "Initial maintenance check: no checkpoint found in state, full inventory required"
          }
        },
        {
          "title": "Subsequent run with pending commits",
          "input": {
            "path": "/srv/workspace/order-service"
          },
          "output": {
            "hasChanges": true,
            "path": "/srv/workspace/order-service",
            "repo": "order-service",
            "branch": "release",
            "from": "a1b2c3d4e5f607182930415263748596a7b8c9d0",
            "to": "b2c3d4e5f607182930415263748596a7b8c9d0e1",
            "commitCount": 2,
            "initialInventoryRequired": false,
            "commits": [
              {
                "hash": "b2c3d4e5f607182930415263748596a7b8c9d0e1",
                "shortHash": "b2c3d4e",
                "message": "feat: add budget limit check before campaign trigger",
                "author": "Alice <alice@example.com>",
                "date": "2026-09-24T08:00:00Z"
              },
              {
                "hash": "c3d4e5f607182930415263748596a7b8c9d0e1f2",
                "shortHash": "c3d4e5f",
                "message": "fix: correct error code on auth rejection",
                "author": "Bob <bob@example.com>",
                "date": "2026-09-24T08:30:00Z"
              }
            ],
            "changedFilesSummary": {
              "summaryText": "2 files changed, 35 insertions(+), 5 deletions(-)",
              "filesChanged": 2,
              "insertions": 35,
              "deletions": 5,
              "files": [
                {
                  "file": "src/campaign/budget.ts",
                  "changes": "30 +++-"
                },
                {
                  "file": "src/auth/handler.ts",
                  "changes": "10 +++++-----"
                }
              ]
            },
            "message": "Found 2 new commit(s) since last checkpoint"
          }
        },
        {
          "title": "Subsequent run with no changes",
          "input": {
            "path": "/srv/workspace/order-service"
          },
          "output": {
            "hasChanges": false,
            "path": "/srv/workspace/order-service",
            "repo": "order-service",
            "branch": "release",
            "from": "b2c3d4e5f607182930415263748596a7b8c9d0e1",
            "to": "b2c3d4e5f607182930415263748596a7b8c9d0e1",
            "commitCount": 0,
            "initialInventoryRequired": false,
            "commits": [],
            "message": "Repository is up to date with last checked commit"
          }
        },
        {
