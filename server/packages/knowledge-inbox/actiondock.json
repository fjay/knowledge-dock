{
  "$schema": "https://actiondock.dev/schema/v2.json",
  "schemaVersion": 2,
  "id": "knowledge",
  "name": "Knowledge Inbox",
  "version": "0.1.0",
  "description": "Feedback and append plane for knowledge base maintenance, collecting, listing, and archiving candidate markdown documents",
  "config": {
    "KNOWLEDGE_INBOX_ROOT": {
      "type": "string",
      "description": "Root storage directory path for knowledge inbox candidates and archives (default: /srv/knowledge-inbox)",
      "env": "KNOWLEDGE_INBOX_ROOT"
    }
  },
  "actions": {
    "knowledge.collect": {
      "entry": "actions/knowledge-collect.ts",
      "description": "Collect candidate markdown knowledge documents with automatic frontmatter enrichment, secure ID generation, and structured pending directory storage. Retains flat arguments for simple cases, and recommends passing parameters via a JSON file with --input-file <path> for multiline markdown documents with frontmatter to avoid shell quotation and escaping errors.",
      "inputSchema": {
        "type": "object",
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "type": "string",
            "description": "Markdown text content of the candidate knowledge document. Simple text supports flat arguments; for complete candidate documents with frontmatter and semantic sections, passing input via a JSON file with --input-file <path> is recommended to avoid shell escaping errors.",
            "examples": [
              "# MySQL Connection Timeout Solution\n\nWhen encountering error 2006 (HY000), adjust wait_timeout in my.cnf.",
              "---\ntitle: Kafka Lag Alert Remediation\ndomain: messaging\nrepos:\n  - order-service\ntags: [kafka, devops]\n---\n\n## Symptoms\nConsumer group lag spikes..."
            ]
          },
          "filename": {
            "type": "string",
            "description": "Optional suggested filename or title slug for the document (e.g. 'mysql-timeout' or 'kafka-lag.md')",
            "examples": [
              "mysql-timeout",
              "kafka-lag.md",
              "redis-oom-incident"
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "id",
          "filename",
          "path",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique candidate document identifier (format: YYYYMMDD-hash)"
          },
          "filename": {
            "type": "string",
            "description": "Normalized, safe filename written to the pending directory"
          },
          "path": {
            "type": "string",
            "description": "Absolute filesystem path where the markdown file was stored"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending"
            ],
            "description": "Current lifecycle status of the collected document"
          }
        }
      },
      "examples": [
        {
          "title": "Collect raw markdown without frontmatter",
          "input": {
            "content": "# Redis Cluster Split Brain Recovery\n\nCheck cluster nodes quorum and verify network partitions.",
            "filename": "redis-split-brain"
          },
          "output": {
            "id": "20260924-a1b2c3",
            "filename": "20260924-112345-a1b2c3-redis-split-brain.md",
            "path": "/srv/knowledge-inbox/pending/20260924-112345-a1b2c3-redis-split-brain.md",
            "status": "pending"
          }
        },
        {
          "title": "Collect structured markdown with existing frontmatter",
          "input": {
            "content": "---\ntitle: Kubernetes Pod Eviction Troubleshooting\ndomain: infrastructure\nrepos:\n  - order-service\ntags:\n  - k8s\n  - memory\n---\n\nWhen disk pressure occurs, inspect ephemeral storage limits.",
            "filename": "k8s-pod-eviction.md"
          },
          "output": {
            "id": "20260924-d4e5f6",
            "filename": "20260924-112500-d4e5f6-k8s-pod-eviction.md",
            "path": "/srv/knowledge-inbox/pending/20260924-112500-d4e5f6-k8s-pod-eviction.md",
            "status": "pending"
          }
        },
        {
          "title": "Collect candidate without filename, inferring title slug",
          "input": {
            "content": "# Nginx 502 Bad Gateway 常见排查\n\n检查 upstream php-fpm 或 node 进程是否存活。"
          },
          "output": {
            "id": "20260924-e7f8a9",
            "filename": "20260924-112610-e7f8a9-nginx-502-bad-gateway-常见排查.md",
            "path": "/srv/knowledge-inbox/pending/20260924-112610-e7f8a9-nginx-502-bad-gateway-常见排查.md",
            "status": "pending"
          }
        }
      ]
    },
    "knowledge.list": {
      "entry": "actions/knowledge-list.ts",
      "description": "List knowledge candidate documents filtered by lifecycle status (pending, processed, or all) and optional calendar year, sorted in descending order by creation timestamp.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processed",
              "all"
            ],
            "description": "Filter candidates by processing status. Defaults to 'pending'.",
            "default": "pending",
            "examples": [
              "pending",
              "processed",
              "all"
            ]
          },
          "year": {
            "type": "string",
            "description": "Optional 4-digit calendar year filter (e.g. '2026'). Restricts scanned processed archives and filtered results to the specified year.",
            "examples": [
              "2026",
              "2025"
            ]
          },
          "repo": {
            "type": "string",
            "description": "Optional repository identifier filter. Matches candidate documents associated with this repository.",
            "examples": [
              "order-service"
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "description": "List of knowledge documents ordered by creation time descending",
            "items": {
              "type": "object",
              "required": [
                "id",
                "filename",
                "path",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique document identifier"
                },
                "filename": {
                  "type": "string",
                  "description": "Base filename of the document"
                },
                "path": {
                  "type": "string",
                  "description": "Absolute path to the document file"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "processed"
                  ],
                  "description": "Document lifecycle status"
                },
                "year": {
                  "type": "string",
                  "description": "Calendar year extracted from directory hierarchy, creation timestamp, or candidate ID prefix"
                },
                "title": {
                  "type": "string",
                  "description": "Document title extracted from frontmatter or heading"
                },
                "domain": {
                  "type": "string",
                  "description": "Subject domain extracted from frontmatter"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Tags extracted from frontmatter"
                },
                "repos": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Associated repository identifiers extracted from frontmatter"
                },
                "createdAt": {
                  "type": "string",
                  "description": "ISO 8601 creation timestamp"
                },
                "archivedAt": {
                  "type": "string",
                  "description": "ISO 8601 archive timestamp (if processed)"
                },
                "resolution": {
                  "type": "string",
                  "enum": [
                    "accepted",
                    "duplicate",
                    "rejected",
                    "insufficient_evidence"
                  ],
                  "description": "Processing resolution if archived"
                },
                "archiveNote": {
                  "type": "string",
                  "description": "Archival note or conclusion if provided"
                },
                "author": {
                  "type": "string",
                  "description": "Contributor username in normalized lowercase format"
                }
              }
            }
          }
        }
      },
      "examples": [
        {
          "title": "List pending knowledge candidates awaiting review",
          "input": {
            "status": "pending"
          },
          "output": {
            "items": [
              {
                "id": "20260924-a1b2c3",
                "filename": "20260924-112345-a1b2c3-redis-split-brain.md",
                "path": "/srv/knowledge-inbox/pending/20260924-112345-a1b2c3-redis-split-brain.md",
                "status": "pending",
                "year": "2026",
                "title": "Redis Cluster Split Brain Recovery",
                "domain": "infrastructure",
                "tags": [
                  "redis",
                  "cluster"
                ],
                "createdAt": "2026-09-24T11:23:45.000Z"
              }
            ]
          }
        },
        {
          "title": "List processed archived documents filtered by year",
          "input": {
            "status": "processed",
            "year": "2026"
          },
          "output": {
            "items": [
              {
                "id": "20260924-d4e5f6",
                "filename": "20260924-112500-d4e5f6-k8s-pod-eviction.md",
                "path": "/srv/knowledge-inbox/processed/2026/accepted/20260924-112500-d4e5f6-k8s-pod-eviction.md",
                "status": "processed",
                "year": "2026",
                "title": "Kubernetes Pod Eviction Troubleshooting",
                "domain": "infrastructure",
                "tags": [
                  "k8s"
                ],
                "createdAt": "2026-09-24T11:25:00.000Z",
                "archivedAt": "2026-09-24T11:30:00.000Z",
                "resolution": "accepted",
                "archiveNote": "Merged into cluster guide"
              }
            ]
          }
        },
        {
          "title": "List all candidates across all statuses",
          "input": {
            "status": "all"
          },
          "output": {
            "items": [
              {
                "id": "20260924-a1b2c3",
                "filename": "20260924-112345-a1b2c3-redis-split-brain.md",
                "path": "/srv/knowledge-inbox/pending/20260924-112345-a1b2c3-redis-split-brain.md",
                "status": "pending",
                "year": "2026",
                "title": "Redis Cluster Split Brain Recovery",
                "createdAt": "2026-09-24T11:23:45.000Z"
              }
            ]
          }
        }
      ]
    },
    "knowledge.archive": {
      "entry": "actions/knowledge-archive.ts",
      "description": "Archive a pending candidate document to the processed folder under its year and resolution category (processed/<year>/<resolution>/), updating its frontmatter with resolution status and notes.",
      "inputSchema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Candidate document identifier or filename to archive",
            "examples": [
              "20260924-a1b2c3",
              "20260924-112345-a1b2c3-redis-split-brain.md"
            ]
          },
          "resolution": {
            "type": "string",
            "enum": [
              "accepted",
              "duplicate",
              "rejected",
              "insufficient_evidence"
            ],
            "description": "Archival resolution decision. Defaults to 'accepted'.",
            "default": "accepted",
            "examples": [
              "accepted",
              "duplicate",
              "rejected",
              "insufficient_evidence"
            ]
          },
          "note": {
            "type": "string",
            "description": "Optional archival notes or decision explanation",
            "examples": [
              "Merged into database troubleshooting guide",
              "Duplicate of KB-20260901-01",
              "Insufficient diagnostic evidence provided"
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "id",
          "fromPath",
          "toPath",
          "resolution",
          "status",
          "year"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifier of the archived document"
          },
          "fromPath": {
            "type": "string",
            "description": "Original source file path in the pending directory"
          },
          "toPath": {
            "type": "string",
            "description": "Target destination file path in the processed directory"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "accepted",
              "duplicate",
              "rejected",
              "insufficient_evidence"
            ],
            "description": "Applied resolution outcome"
          },
          "status": {
            "type": "string",
            "enum": [
              "archived"
            ],
            "description": "Lifecycle status after archive"
          },
          "year": {
            "type": "string",
            "description": "Calendar year category under which the document was archived"
          }
        }
      },
      "examples": [
        {
          "title": "Archive accepted candidate into permanent knowledge base",
          "input": {
            "id": "20260924-a1b2c3",
            "resolution": "accepted",
            "note": "Merged into redis operations runbook"
          },
          "output": {
            "id": "20260924-a1b2c3",
            "fromPath": "/srv/knowledge-inbox/pending/20260924-112345-a1b2c3-redis-split-brain.md",
            "toPath": "/srv/knowledge-inbox/processed/2026/accepted/20260924-112345-a1b2c3-redis-split-brain.md",
            "resolution": "accepted",
            "status": "archived",
            "year": "2026"
          }
        },
        {
          "title": "Archive duplicate candidate with reference note",
          "input": {
            "id": "20260924-112345-a1b2c3-redis-split-brain.md",
            "resolution": "duplicate",
            "note": "Duplicate of KB-20260901-01"
          },
          "output": {
            "id": "20260924-a1b2c3",
            "fromPath": "/srv/knowledge-inbox/pending/20260924-112345-a1b2c3-redis-split-brain.md",
            "toPath": "/srv/knowledge-inbox/processed/2026/duplicate/20260924-112345-a1b2c3-redis-split-brain.md",
            "resolution": "duplicate",
            "status": "archived",
            "year": "2026"
          }
        },
        {
          "title": "Archive candidate rejected due to insufficient evidence",
          "input": {
            "id": "20260924-d4e5f6",
            "resolution": "insufficient_evidence",
            "note": "Missing reproduction logs and kernel version details"
          },
          "output": {
            "id": "20260924-d4e5f6",
            "fromPath": "/srv/knowledge-inbox/pending/20260924-112500-d4e5f6-k8s-pod-eviction.md",
            "toPath": "/srv/knowledge-inbox/processed/2026/insufficient_evidence/20260924-112500-d4e5f6-k8s-pod-eviction.md",
            "resolution": "insufficient_evidence",
            "status": "archived",
            "year": "2026"
          }
        }
      ]
    },
    "knowledge.query": {
      "entry": "actions/knowledge-query.ts",
      "description": "Query knowledge candidate documents across pending and processed archives with multi-criteria filtering by ID or filename, keyword in title/body/tags/archiveNote, contributor author, repository, status, and result count limit.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Candidate document identifier (e.g. '20260924-a1b2c3') or exact filename to match",
            "examples": [
              "20260924-a1b2c3",
              "20260924-112345-a1b2c3-redis-split-brain.md"
            ]
          },
          "keyword": {
            "type": "string",
            "description": "Fuzzy keyword matching in document title, markdown body, tags, and archive note",
            "examples": [
              "split brain",
              "eviction",
              "timeout"
            ]
          },
          "author": {
            "type": "string",
            "description": "Filter by contributor username (case-insensitive exact match, e.g. 'jay.wu')",
            "examples": [
              "jay.wu"
            ]
          },
          "repo": {
            "type": "string",
            "description": "Filter by associated repository identifier",
            "examples": [
              "order-service"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processed",
              "all"
            ],
            "description": "Filter by processing status. Defaults to 'all'.",
            "default": "all",
            "examples": [
              "all",
              "pending",
              "processed"
            ]
          },
          "limit": {
            "type": "integer",
            "description": "Maximum number of candidate documents to return (default: 20, max: 100)",
            "default": 20,
            "minimum": 1,
            "maximum": 100,
            "examples": [
              20,
              50
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "description": "List of matched knowledge documents ordered by creation time descending",
            "items": {
              "type": "object",
              "required": [
                "id",
                "filename",
                "path",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique candidate document identifier"
                },
                "filename": {
                  "type": "string",
                  "description": "Base filename of the document"
                },
                "path": {
                  "type": "string",
                  "description": "Absolute filesystem path to the document"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "processed"
                  ],
                  "description": "Document lifecycle status"
                },
                "resolution": {
                  "type": "string",
                  "enum": [
                    "accepted",
                    "duplicate",
                    "rejected",
                    "insufficient_evidence"
                  ],
                  "description": "Processing resolution if archived"
                },
                "archiveNote": {
                  "type": "string",
                  "description": "Archival note or conclusion if provided"
                },
                "author": {
                  "type": "string",
                  "description": "Contributor username in normalized lowercase format"
                },
                "title": {
                  "type": "string",
                  "description": "Document title extracted from frontmatter or heading"
                },
                "domain": {
                  "type": "string",
                  "description": "Subject domain extracted from frontmatter"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Tags extracted from frontmatter"
                },
                "repos": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Associated repository identifiers extracted from frontmatter"
                },
                "createdAt": {
                  "type": "string",
                  "description": "ISO 8601 creation timestamp"
                },
                "archivedAt": {
                  "type": "string",
                  "description": "ISO 8601 archive timestamp (if processed)"
                },
                "year": {
                  "type": "string",
                  "description": "Calendar year extracted from directory hierarchy, creation timestamp, or candidate ID prefix"
                }
              }
            }
          }
        }
      },
      "examples": [
        {
          "title": "Query candidate by exact ID across all statuses",
          "input": {
            "id": "20260924-a1b2c3"
          },
          "output": {
            "items": [
              {
                "id": "20260924-a1b2c3",
                "filename": "20260924-112345-a1b2c3-redis-split-brain.md",
                "path": "/srv/knowledge-inbox/pending/20260924-112345-a1b2c3-redis-split-brain.md",
                "status": "pending",
                "author": "jay.wu",
                "title": "Redis Cluster Split Brain Recovery",
                "domain": "infrastructure",
                "tags": [
                  "redis",
                  "cluster"
                ],
                "repos": [
                  "order-service"
                ],
                "createdAt": "2026-09-24T11:23:45.000Z",
                "year": "2026"
              }
            ]
          }
        },
        {
          "title": "Query candidate by contributor author and status",
          "input": {
            "author": "jay.wu",
            "status": "pending",
            "limit": 10
          },
          "output": {
            "items": [
              {
                "id": "20260924-a1b2c3",
                "filename": "20260924-112345-a1b2c3-redis-split-brain.md",
                "path": "/srv/knowledge-inbox/pending/20260924-112345-a1b2c3-redis-split-brain.md",
                "status": "pending",
                "author": "jay.wu",
                "title": "Redis Cluster Split Brain Recovery",
                "domain": "infrastructure",
                "tags": [
                  "redis"
                ],
                "createdAt": "2026-09-24T11:23:45.000Z",
                "year": "2026"
              }
            ]
          }
        },
        {
          "title": "Query candidate by keyword matching title, body, or archiveNote",
          "input": {
            "keyword": "eviction",
            "status": "processed"
          },
          "output": {
            "items": [
              {
                "id": "20260924-d4e5f6",
                "filename": "20260924-112500-d4e5f6-k8s-pod-eviction.md",
                "path": "/srv/knowledge-inbox/processed/2026/accepted/20260924-112500-d4e5f6-k8s-pod-eviction.md",
                "status": "processed",
                "resolution": "accepted",
                "archiveNote": "Merged into cluster guide",
                "author": "jay.wu",
                "title": "Kubernetes Pod Eviction Troubleshooting",
                "domain": "infrastructure",
                "tags": [
                  "k8s"
                ],
                "repos": [
                  "order-service"
                ],
                "createdAt": "2026-09-24T11:25:00.000Z",
                "archivedAt": "2026-09-24T11:30:00.000Z",
                "year": "2026"
              }
            ]
          }
        }
      ]
    },
    "knowledge.leaderboard": {
      "entry": "actions/knowledge-leaderboard.ts",
      "description": "Aggregate and query knowledge contribution leaderboard statistics across pending and processed candidate documents, ranking contributors by accepted count, acceptance rate, and submission volume.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "enum": [
              "all",
              "year",
              "month"
            ],
            "default": "all",
            "description": "Time period scope for contribution statistics ('all', 'year', 'month', default: 'all')",
            "examples": [
              "all",
              "year",
              "month"
            ]
          },
          "year": {
            "type": "string",
            "description": "Optional 4-digit calendar year filter (e.g. '2026')",
            "examples": [
              "2026"
            ]
          },
          "repo": {
            "type": "string",
            "description": "Optional repository identifier to filter candidate contributions",
            "examples": [
              "order-service"
            ]
          },
          "limit": {
            "type": "integer",
            "description": "Maximum number of contributors to return in leaderboard (default: 10, max: 100)",
            "default": 10,
            "minimum": 1,
            "maximum": 100,
            "examples": [
              10,
              20
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "leaderboard",
          "overview"
        ],
        "properties": {
          "leaderboard": {
            "type": "array",
            "description": "Ranked list of top contributors matching the filter criteria",
            "items": {
              "type": "object",
              "required": [
                "rank",
                "author",
                "acceptedCount",
                "totalCount",
                "pendingCount",
                "rejectedCount",
                "acceptanceRate",
                "topDomains"
              ],
              "properties": {
                "rank": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Leaderboard rank starting from 1"
                },
                "author": {
                  "type": "string",
                  "description": "Normalized contributor author username"
                },
                "acceptedCount": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Number of accepted and merged candidate submissions"
                },
                "totalCount": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Total number of candidate submissions by this author in the scope"
                },
                "pendingCount": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Number of candidate submissions pending review"
                },
                "rejectedCount": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Number of rejected or non-accepted submissions"
                },
                "acceptanceRate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Acceptance rate rounded to 2 decimal places (acceptedCount / totalCount)"
                },
                "topDomains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Up to 3 most frequent domain categories contributed by this author"
                }
              }
            }
          },
          "overview": {
            "type": "object",
            "required": [
              "totalContributors",
              "totalSubmissions",
              "totalAccepted",
