# ==============================================================================
# knowledge-server 环境配置示例
# 复制为 .env 并按需修改
# ==============================================================================

# ActionDock 虚拟视图鉴权令牌 (必须手动生成高强度密钥，至少 32 字符，两者绝对不可相同)
# 推荐生成命令: openssl rand -hex 32
ACTIONDOCK_TOKEN=
ACTIONDOCK_AGENT_TOKEN=

# 运行环境时区 (如 Asia/Shanghai，默认 Asia/Shanghai)
TZ=Asia/Shanghai

# 服务外部暴露端口 (原生 HTTPS 单端口多视图模式，默认 443，通过不同 Bearer Token 自动由虚拟视图路由权限)
PORT=443

# 宿主机持久化根目录 (state/、workspace/、inbox/、certs/、logs/、remotes/ 基于此目录挂载；仓库清单使用项目内 server/config/repos.json)
KNOWLEDGE_DATA_DIR=/data/knowledge

# 宿主机 SSH 密钥挂载目录 (用于免密操作内部 Git 仓)
SSH_DIR=/root/.ssh

# Git 提交作者与邮箱配置 (知识库维护提交时的身份标识)
GIT_AUTHOR_NAME="Knowledge Maintainer"
GIT_AUTHOR_EMAIL="maintainer@actiondock.local"

# 构建期 APT 镜像源 (内网/隔离环境可配置内部镜像，例如 mirrors.tuna.tsinghua.edu.cn)
APT_MIRROR=deb.debian.org

# 是否在镜像中内置 Chromium 无头浏览器 (浏览器/渲染类扩展包需要时置为 true，镜像体积约增 600MB)
WITH_CHROMIUM=false
