{
  "$schema": "https://actiondock.dev/schema/v2.json",
  "schemaVersion": 2,
  "id": "workspace",
  "name": "Workspace",
  "version": "0.1.0",
  "description": "Engineering workspace search, controlled file read/write/edit, in-workspace bash execution and link verification",
  "config": {
    "WORKSPACE_ROOT": {
      "type": "string",
      "description": "Workspace root directory path (defaults to process current working directory if unset)",
      "env": "WORKSPACE_ROOT"
    }
  },
  "actions": {
    "search.rg": {
      "entry": "actions/search-rg.ts",
      "description": "Search text in the engineering workspace using ripgrep semantics. Most input fields map directly to ripgrep long options. Paths are relative to the workspace root.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string",
            "description": "ripgrep search pattern (regular expression by default, or literal if fixedStrings is true)",
            "examples": [
              "refund_status",
              "foo.bar()"
            ]
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Paths to search, relative to workspace root. Defaults to workspace root if omitted.",
            "examples": [
              [
                "src"
              ],
              [
                "src/index.ts"
              ]
            ]
          },
          "fixedStrings": {
            "type": "boolean",
            "description": "Treat pattern as literal string instead of regular expression (-F)"
          },
          "ignoreCase": {
            "type": "boolean",
            "description": "Case insensitive search (-i)"
          },
          "smartCase": {
            "type": "boolean",
            "description": "Smart case search: case-insensitive unless pattern contains uppercase (-S)"
          },
          "wordRegexp": {
            "type": "boolean",
            "description": "Only match whole words (-w)"
          },
          "lineRegexp": {
            "type": "boolean",
            "description": "Only match whole lines (-x)"
          },
          "glob": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Glob patterns to include or exclude (e.g. ['*.ts', '!generated/**']) (-g)",
            "examples": [
              [
                "*.ts",
                "!generated/**"
              ]
            ]
          },
          "type": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Only search files matching file type definition (e.g. ['ts', 'py']) (--type)",
            "examples": [
              [
                "ts"
              ]
            ]
          },
          "typeNot": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Do not search files matching file type definition (--type-not)"
          },
          "hidden": {
            "type": "boolean",
            "description": "Search hidden files and directories (--hidden)"
          },
          "noIgnore": {
            "type": "boolean",
            "description": "Do not respect .gitignore or other ignore files (--no-ignore)"
          },
          "follow": {
            "type": "boolean",
            "description": "Follow symbolic links (--follow)"
          },
          "context": {
            "type": "number",
            "description": "Show NUM lines before and after each match (-C)"
          },
          "beforeContext": {
            "type": "number",
            "description": "Show NUM lines before each match (-B)"
          },
          "afterContext": {
            "type": "number",
            "description": "Show NUM lines after each match (-A)"
          },
          "multiline": {
            "type": "boolean",
            "description": "Enable matching across multiple lines (-U)"
          },
          "multilineDotall": {
            "type": "boolean",
            "description": "Make '.' in regex match newlines (--multiline-dotall)"
          },
          "maxResults": {
            "type": "number",
            "description": "Maximum total number of matches to return across all files. Defaults to 200 (hard cap 200).",
            "default": 200
          },
          "maxCount": {
            "type": "number",
            "description": "Limit number of matching lines per file (-m). Note: this limits matches per file, not global total matches."
          },
          "maxColumns": {
            "type": "number",
            "description": "Don't print lines longer than this limit in bytes (--max-columns)"
          },
          "maxColumnsPreview": {
            "type": "boolean",
            "description": "Print preview for lines exceeding maxColumns (--max-columns-preview)"
          }
        },
        "required": [
          "pattern"
        ],
        "additionalProperties": false,
        "examples": [
          {
            "pattern": "refund_status",
            "paths": [
              "src"
            ]
          },
          {
            "pattern": "foo.bar()",
            "fixedStrings": true
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "line": {
                  "type": "number"
                },
                "text": {
                  "type": "string"
                },
                "before": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "line": {
                        "type": "number"
                      },
                      "text": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "line",
                      "text"
                    ]
                  }
                },
                "after": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "line": {
                        "type": "number"
                      },
                      "text": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "line",
                      "text"
                    ]
                  }
                },
                "truncated": {
                  "type": "boolean"
                }
              },
              "required": [
                "path",
                "line",
                "text"
              ]
            }
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "matches",
          "truncated"
        ]
      }
    },
    "files.read": {
      "entry": "actions/files-read.ts",
      "description": "Read UTF-8 text from a file in the engineering workspace. Supports reading from a specific line with bounded output. Paths are relative to the workspace root.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Path to the file relative to the workspace root",
            "examples": [
              "src/index.ts"
            ]
          },
          "startLine": {
            "type": "number",
            "description": "1-based starting line number. Defaults to 1.",
            "default": 1
          },
          "maxLines": {
            "type": "number",
            "description": "Maximum number of lines to read. Defaults to 2000.",
            "default": 2000
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "examples": [
          {
            "path": "package.json",
            "startLine": 1,
            "maxLines": 50
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "startLine": {
            "type": "number"
          },
          "endLine": {
            "type": "number"
          },
          "content": {
            "type": "string"
          },
          "hasMore": {
            "type": "boolean"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "startLine",
          "endLine",
          "content",
          "hasMore"
        ]
      }
    },
    "files.list": {
      "entry": "actions/files-list.ts",
      "description": "List files and directories in the engineering workspace. Paths are relative to the workspace root.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Directory path relative to workspace root. Defaults to workspace root.",
            "examples": [
              "src"
            ]
          },
          "depth": {
            "type": "number",
            "description": "Maximum directory traversal depth. Defaults to 1.",
            "default": 1
          },
          "hidden": {
            "type": "boolean",
            "description": "Whether to include hidden files. Defaults to false.",
            "default": false
          }
        },
        "additionalProperties": false,
        "examples": [
          {
            "path": "",
            "depth": 1,
            "hidden": false
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "file",
                    "directory"
                  ]
                },
                "sizeBytes": {
                  "type": "number"
                }
              },
              "required": [
                "path",
                "type"
              ]
            }
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "truncated"
        ]
      }
    },
    "files.write": {
      "entry": "actions/files-write.ts",
      "description": "Write UTF-8 text content to a file in the workspace. Supports automatic parent directory creation and overwrite control.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Path to the file relative to the workspace root",
            "examples": [
              "src/new-file.ts",
              "docs/notes.md"
            ]
          },
          "content": {
            "type": "string",
            "description": "Plain text content to write to the file",
            "examples": [
              "console.log('hello world');\n"
            ]
          },
          "createDirs": {
            "type": "boolean",
            "description": "Whether to automatically create parent directories if they do not exist. Defaults to true.",
            "default": true
          },
          "overwrite": {
            "type": "boolean",
            "description": "Whether to overwrite an existing file. Defaults to true.",
            "default": true
          }
        },
        "required": [
          "path",
          "content"
        ],
        "additionalProperties": false,
        "examples": [
          {
            "path": "src/example.ts",
            "content": "export const example = 1;\n",
            "createDirs": true,
            "overwrite": true
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Normalized path relative to the workspace root"
          },
          "bytesWritten": {
            "type": "number",
            "description": "Number of bytes written to the file"
          },
          "created": {
            "type": "boolean",
            "description": "Whether a new file was created"
          }
        },
        "required": [
          "path",
          "bytesWritten",
          "created"
        ]
      }
    },
    "files.edit": {
      "entry": "actions/files-edit.ts",
      "description": "Edit a file in the workspace by replacing target text content. Supports line range constraints and multiple replacements control.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Path to the file relative to the workspace root",
            "examples": [
              "src/index.ts"
            ]
          },
          "targetContent": {
            "type": "string",
            "description": "Exact text content to find and replace",
            "examples": [
              "const foo = 1;"
            ]
          },
          "replacementContent": {
            "type": "string",
            "description": "Replacement text content",
            "examples": [
              "const foo = 2;"
            ]
          },
          "allowMultiple": {
            "type": "boolean",
            "description": "Whether to allow replacing multiple occurrences. Defaults to false.",
            "default": false
          },
          "startLine": {
            "type": "number",
            "description": "1-based starting line number to constrain the search range"
          },
          "endLine": {
            "type": "number",
            "description": "1-based ending line number to constrain the search range"
          }
        },
        "required": [
          "path",
          "targetContent",
          "replacementContent"
        ],
        "additionalProperties": false,
        "examples": [
          {
            "path": "src/index.ts",
            "targetContent": "const a = 1;",
            "replacementContent": "const a = 2;",
            "allowMultiple": false
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Path relative to the workspace root"
          },
          "replacementsCount": {
            "type": "number",
            "description": "Number of occurrences replaced"
          },
          "bytesWritten": {
            "type": "number",
            "description": "Total byte size of the file after replacement"
          }
        },
        "required": [
          "path",
          "replacementsCount",
          "bytesWritten"
        ]
      }
    },

    "bash.exec": {
      "entry": "actions/bash-exec.ts",
      "description": "Execute a bash shell command in the engineering workspace.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "Bash command line string to execute",
            "examples": [
              "git status",
              "git restore .",
              "git diff",
              "npm test"
            ]
          },
          "cwd": {
            "type": "string",
            "description": "Working directory path relative to workspace root. Defaults to workspace root.",
            "examples": [
              "",
              "packages/knowledge-workspace"
            ]
          },
          "timeoutMs": {
            "type": "number",
            "description": "Execution timeout in milliseconds. Defaults to 60000 (60 seconds).",
            "default": 60000
          }
        },
        "required": [
          "command"
        ],
        "additionalProperties": false,
        "examples": [
          {
            "command": "git status"
          },
          {
            "command": "git restore .",
            "cwd": "packages/knowledge-workspace"
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "exitCode": {
            "type": [
              "number",
              "null"
            ],
            "description": "Process exit code (0 indicates success)"
          },
          "content": {
            "type": "string",
            "description": "Raw terminal output text of the command"
          },
          "truncated": {
            "type": "boolean",
            "description": "Whether output was truncated due to buffer limit"
          }
        },
        "required": [
          "exitCode",
          "content"
        ]
      }
    },
    "links.verify": {
      "entry": "actions/links-verify.ts",
      "description": "Verify local relative links and heading anchor references in markdown documentation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Path to a directory or markdown file to scan relative to workspace root. Defaults to '.'.",
            "default": ".",
            "examples": [
              ".",
              "docs",
              "README.md"
            ]
          },
          "checkAnchors": {
            "type": "boolean",
            "description": "Whether to verify document heading anchor targets. Defaults to true.",
            "default": true
          },
          "ignoreDirs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional directory names to ignore during scanning.",
            "examples": [
              [
                "archive",
                "vendor"
              ]
            ]
          }
        },
        "additionalProperties": false,
        "examples": [
          {
            "path": ".",
            "checkAnchors": true,
            "ignoreDirs": [
              "archive"
            ]
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "scannedFiles": {
            "type": "integer",
            "description": "Number of markdown files scanned"
          },
          "totalLinks": {
            "type": "integer",
            "description": "Total number of local relative links checked"
          },
          "brokenCount": {
            "type": "integer",
            "description": "Total number of broken links found"
          },
          "brokenLinks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "description": "Relative path to markdown file containing the broken link"
                },
                "line": {
                  "type": "integer",
                  "description": "1-based line number where the broken link appears"
                },
                "link": {
                  "type": "string",
                  "description": "Raw link text as written in document"
                },
                "target": {
                  "type": "string",
                  "description": "Resolved relative target path or anchor"
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "TARGET_NOT_FOUND",
                    "ANCHOR_NOT_FOUND"
                  ],
                  "description": "Failure reason code (TARGET_NOT_FOUND or ANCHOR_NOT_FOUND)"
                }
              },
              "required": [
                "file",
                "line",
                "link",
                "target",
                "reason"
              ]
            },
            "description": "List of broken links found during scan"
          }
        },
        "required": [
          "scannedFiles",
          "totalLinks",
          "brokenCount",
          "brokenLinks"
        ]
      }
    }
  },
  "files": [
    "src",
    ".actiondock/generated/actions.d.ts"
  ],
  "playbooks": {
    "inspect-workspace": {
      "entry": "playbooks/inspect-workspace.md",
      "description": "Standard operating procedure for exploring files and searching codebase in the engineering workspace",
      "actions": [
        "search.rg",
        "files.read",
        "files.list",
        "files.write",
        "files.edit",
        "links.verify",
        "bash.exec"
      ]
    }
  }
}
